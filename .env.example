# PostgreSQL
POSTGRES_DB=spot_scanner
POSTGRES_USER=spot_scanner
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5432

# Application
APP_PORT=8080
APP_HTTP_ADDR=:8080
APP_LOG_LEVEL=info
APP_SHUTDOWN_TIMEOUT=10s
MIGRATIONS_DIR=./migrations
APP_DATA_DIR=./data

DATABASE_URL=
DB_POOL_MAX_CONNS=20
DB_POOL_MIN_CONNS=2

# Public Bybit V5 Spot API
BYBIT_REST_URL=https://api.bybit.com
BYBIT_PUBLIC_SPOT_WS_URL=wss://stream.bybit.com/v5/public/spot
SPOT_MARKET_REFRESH_INTERVAL=1m

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_ACCESS_PASSWORD=change_this_to_a_long_random_password
