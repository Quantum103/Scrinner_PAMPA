# Application
APP_LOG_LEVEL=info

# Bybit public endpoints only. No API keys are used by this project.
BYBIT_REST_URL=https://api.bybit.com
BYBIT_PUBLIC_WS_URL=wss://stream.bybit.com/v5/public/linear

# Public market data
MARKET_DATA_ENABLED=true
DATA_UPDATE_INTERVAL=2s
MAX_TRACKED_CONTRACTS=100

# Strategy parameters are configuration placeholders for a later stage.
STRATEGY_VOLUME_MULTIPLIER=2.0
STRATEGY_TRAILING_STOP_PERCENT=2.5
STRATEGY_REVERSAL_CONFIRMATIONS=2

# Virtual account and risk limits
VIRTUAL_DEPOSIT_USDT=10
RISK_PER_TRADE_PERCENT=1
MAX_OPEN_POSITIONS=1

# Paper-trading cost assumptions. Fee rate is applied per side in later simulation.
TRADING_FEE_RATE=0.00055
SLIPPAGE_BPS=5

# Optional Telegram settings. Telegram integration is not implemented yet.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
