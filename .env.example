# Приложение
APP_LOG_LEVEL=info

# Единая SQLite база всего приложения: Paper Trading использует собственные таблицы в этом файле.
APP_DB_PATH=./data/volume_trader.db
APP_DB_BUSY_TIMEOUT=5s

# Только публичные endpoints Bybit. API-ключи не используются.
BYBIT_REST_URL=https://api.bybit.com
BYBIT_PUBLIC_WS_URL=wss://stream.bybit.com/v5/public/linear

# Получение рыночных данных
MARKET_DATA_ENABLED=true
DATA_UPDATE_INTERVAL=2s
INSTRUMENT_REFRESH_INTERVAL=15m
MAX_TRACKED_CONTRACTS=100

# Исторические параметры базовой стратегии; активный поиск входов настраивается через ENTRY_* ниже.
STRATEGY_VOLUME_MULTIPLIER=2.0
STRATEGY_TRAILING_STOP_PERCENT=2.5
STRATEGY_REVERSAL_CONFIRMATIONS=2

# Paper Trading — только виртуальное исполнение; реальные ордера не отправляются.
PAPER_TRADING_ENABLED=true
PAPER_INITIAL_BALANCE_USDT=10
PAPER_TARGET_RISK_PERCENT=2.5
PAPER_MAX_RISK_PERCENT=3
PAPER_MAX_LEVERAGE=2
PAPER_MAX_MARGIN_PERCENT=50
PAPER_MAX_OPEN_POSITIONS=1
PAPER_TRAILING_STOP_PERCENT=2.5

# Дополнительный выход по подтверждённому развороту Order Flow.
PAPER_ORDER_FLOW_EXIT_ENABLED=true
PAPER_ORDER_FLOW_MIN_SIGNALS=3
PAPER_ORDER_FLOW_CONSECUTIVE_INTERVALS=2
PAPER_ORDER_FLOW_OBSERVATION_INTERVAL=1s
PAPER_ORDER_FLOW_MAX_OBSERVATION_GAP=3s
PAPER_ORDER_FLOW_MAX_TAKER_BUY_SHARE_PERCENT=45
PAPER_ORDER_FLOW_TAKER_BUY_SHARE_DROP_PP=10
PAPER_ORDER_FLOW_MIN_TAKER_SELL_SHARE_PERCENT=55
PAPER_ORDER_FLOW_CVD_MIN_DECLINE_PERCENT=0.5
PAPER_ORDER_FLOW_PRICE_STALL_MAX_RISE_PERCENT=0.02

# Расчётные предположения симуляции, а не фактические комиссии аккаунта Bybit.
# Укажи свою ставку taker и ожидаемое проскальзывание, если знаешь их.
PAPER_FEE_RATE=0.00055
PAPER_SLIPPAGE_BPS=5

# Telegram Bot API. После /start отправь пароль из TELEGRAM_ACCESS_PASSWORD в личный чат.
# Минимум 12 символов. Telegram ID вручную указывать не нужно.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ACCESS_PASSWORD=
# Дневной лимит считается от первой сохранённой equity-точки текущего UTC-дня.
# По достижении лимита новые входы блокируются; сопровождение открытой позиции продолжается.
TELEGRAM_DAILY_LOSS_LIMIT_PERCENT=5

# Публичный WebSocket-поток Bybit
WS_ORDERBOOK_DEPTH=50
WS_MAX_SYMBOLS_PER_CONNECTION=25
WS_MAX_ARGS_PER_SUBSCRIBE=10
WS_MAX_DATA_AGE=5s
WS_TRADE_BUFFER_CAPACITY=4096
WS_SEEN_TRADE_ID_CAPACITY=4096

# Анализ рыночных данных
# RVOL: текущий незавершённый интервал / средний объём предыдущих завершённых интервалов.
ANALYSIS_RVOL_INTERVAL=1m
ANALYSIS_RVOL_LOOKBACK_INTERVALS=20
# Окно taker-потока и Delta.
ANALYSIS_FLOW_WINDOW=1m
# CVD — скользящая накопительная Delta за этот период; сброс при разрыве потока.
ANALYSIS_CVD_WINDOW=15m
# Несколько интервалов Momentum через запятую.
ANALYSIS_MOMENTUM_WINDOWS=15s,1m,5m
# Текущий интервал объёма сравнивается с предыдущим таким же интервалом.
ANALYSIS_VOLUME_ACCELERATION_WINDOW=10s
# Absorption: доля агрессивных покупок, рост их объёма к предыдущему окну, предел движения цены.
ANALYSIS_ABSORPTION_MIN_BUY_SHARE=0.70
ANALYSIS_ABSORPTION_BUY_VOLUME_MULTIPLIER=1.5
ANALYSIS_ABSORPTION_MAX_PRICE_CHANGE_PERCENT=0.05
# Сколько ближайших уровней каждой стороны стакана суммировать в котируемой валюте.
ANALYSIS_ORDERBOOK_LEVELS=10


# Поиск точек входа LONG. При сигнале выполняется только виртуальная сделка Paper Trading.
ENTRY_STRATEGY_ENABLED=true
ENTRY_MIN_RVOL=3
ENTRY_MIN_TAKER_BUY_SHARE_PERCENT=65
# Цена не должна уже вырасти более чем на 1.5% за выбранное окно.
ENTRY_MAX_PRICE_CHANGE_PERCENT=1.5
ENTRY_PRICE_CHANGE_WINDOW=5m
# Спред в базисных пунктах; ликвидность суммируется в USDT.
ENTRY_MAX_SPREAD_BPS=15
ENTRY_MIN_BID_LIQUIDITY_QUOTE=5000
ENTRY_MIN_ASK_LIQUIDITY_QUOTE=5000
ENTRY_MIN_BOOK_LEVELS=5
# Защита от одной крупной сделки и слишком короткого всплеска.
ENTRY_MIN_TRADES_IN_FLOW_WINDOW=5
ENTRY_MAX_SINGLE_TRADE_SHARE_PERCENT=35
ENTRY_CONFIRMATION_OBSERVATIONS=3
ENTRY_OBSERVATION_INTERVAL=1s
ENTRY_MAX_OBSERVATION_GAP=3s
ENTRY_SIGNAL_COOLDOWN=1m
ENTRY_REARM_OBSERVATIONS=2
ENTRY_SIGNAL_HISTORY_LIMIT=20
