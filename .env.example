# PostgreSQL (локальная разработка через Docker Compose)
POSTGRES_DB=rsi_scanner
POSTGRES_USER=rsi_scanner
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5432

# Приложение
APP_PORT=8080
APP_HTTP_ADDR=:8080
APP_LOG_LEVEL=info
APP_SHUTDOWN_TIMEOUT=10s
MIGRATIONS_DIR=./migrations

# Подключение формируется docker-compose.yml из параметров PostgreSQL.
# Необязательно: полная строка подключения. При пустом значении она строится из параметров выше.
# Если пароль содержит URL-спецсимволы, укажи здесь URL-кодированный пароль.
DATABASE_URL=
DB_POOL_MAX_CONNS=20
DB_POOL_MIN_CONNS=2

# Только публичные API Bybit V5
BYBIT_REST_URL=https://api.bybit.com
BYBIT_PUBLIC_WS_URL=wss://stream.bybit.com/v5/public/linear

# Параметры сканера
SCANNER_TIMEFRAMES=5,15,60
RSI_LENGTH=14
EMA_LENGTH=9
SCANNER_INSTRUMENT_LIMIT=100
SCANNER_REFRESH_INTERVAL=15m
SCANNER_HISTORY_CANDLES=300

# Telegram Bot API. На первом этапе бот ещё не подключён.
TELEGRAM_BOK_TOKEN=
# Только разрешённые Telegram ID, через запятую.
TELEGRAM_ALLOWED_USER_IDS=
