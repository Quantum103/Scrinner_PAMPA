# Приложение
APP_LOG_LEVEL=info

# Только публичные endpoints Bybit. API-ключи не используются.
BYBIT_REST_URL=https://api.bybit.com
BYBIT_PUBLIC_WS_URL=wss://stream.bybit.com/v5/public/linear

# Получение рыночных данных
MARKET_DATA_ENABLED=true
DATA_UPDATE_INTERVAL=2s
INSTRUMENT_REFRESH_INTERVAL=15m
MAX_TRACKED_CONTRACTS=100

# Параметры стратегии — настройки для будущего этапа, пока не используются.
STRATEGY_VOLUME_MULTIPLIER=2.0
STRATEGY_TRAILING_STOP_PERCENT=2.5
STRATEGY_REVERSAL_CONFIRMATIONS=2

# Виртуальный счёт и риск-менеджмент
VIRTUAL_DEPOSIT_USDT=10
RISK_PER_TRADE_PERCENT=1
MAX_OPEN_POSITIONS=1

# Предположения о комиссиях и проскальзывании для будущей симуляции.
TRADING_FEE_RATE=0.00055
SLIPPAGE_BPS=5

# Настройки Telegram — интеграция пока не реализована.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Публичный WebSocket-поток Bybit
WS_ORDERBOOK_DEPTH=50
WS_MAX_SYMBOLS_PER_CONNECTION=25
WS_MAX_ARGS_PER_SUBSCRIBE=10
WS_MAX_DATA_AGE=5s
WS_TRADE_BUFFER_CAPACITY=4096
WS_SEEN_TRADE_ID_CAPACITY=4096

# Анализ рыночных данных
# RVOL: текущий незавершённый интервал / средний объём предыдущих завершённых интервалов.
ANALYSIS_RVOL_INTERVAL=1m
ANALYSIS_RVOL_LOOKBACK_INTERVALS=20
# Окно taker-потока и Delta.
ANALYSIS_FLOW_WINDOW=1m
# CVD — скользящая накопительная Delta за этот период; сброс при разрыве потока.
ANALYSIS_CVD_WINDOW=15m
# Несколько интервалов Momentum через запятую.
ANALYSIS_MOMENTUM_WINDOWS=15s,1m,5m
# Текущий интервал объёма сравнивается с предыдущим таким же интервалом.
ANALYSIS_VOLUME_ACCELERATION_WINDOW=10s
# Absorption: доля агрессивных покупок, рост их объёма к предыдущему окну, предел движения цены.
ANALYSIS_ABSORPTION_MIN_BUY_SHARE=0.70
ANALYSIS_ABSORPTION_BUY_VOLUME_MULTIPLIER=1.5
ANALYSIS_ABSORPTION_MAX_PRICE_CHANGE_PERCENT=0.05
# Сколько ближайших уровней каждой стороны стакана суммировать в котируемой валюте.
ANALYSIS_ORDERBOOK_LEVELS=10
